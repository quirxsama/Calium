generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  username      String   @unique
  passwordHash  String?
  integrations  Integration[]
  tracking      TrackingEntry[]
  oauth         OAuthTransaction[]
  displayName   String?
  avatarUrl     String?
  bio           String?
  role          String   @default("user") // user | admin
  profilePublic Boolean  @default(true)
  listsPublic   Boolean  @default(true)
  historyPublic Boolean  @default(true)
  isPrivate     Boolean  @default(false) // gizli hesap — takip onayı gerekir
  dndEnabled    Boolean  @default(false) // rahatsız etme modu
  allowOfflineInvites Boolean @default(false) // arkadaşlar oda açmadan da davet gönderebilir
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favorites   Favorite[]
  history     HistoryItem[]
  lists       UserList[]
  listLikes   ListLike[]
  preference  Preference?

  // Social graph
  following        Follow[]        @relation("Following")
  followers        Follow[]        @relation("Followers")
  sentRequests     FollowRequest[] @relation("SentRequests")
  receivedRequests FollowRequest[] @relation("ReceivedRequests")
  blocking         Block[]         @relation("Blocking")
  blockedBy        Block[]         @relation("BlockedBy")

  // Rooms
  hostedRooms   Room[]        @relation("HostedRooms")
  roomMembers   RoomMember[]
  sentInvites   RoomInvite[]  @relation("InvitesSent")
  recvInvites   RoomInvite[]  @relation("InvitesRecv")

  activities    Activity[]
  notifications Notification[]
  loginIps      LoginIp[]
}

model LoginIp {
  id        String   @id @default(cuid())
  userId    String
  ip        String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ip])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model FollowRequest {
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())

  requester User @relation("SentRequests",     fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("ReceivedRequests", fields: [targetId],    references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([targetId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking",  fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Room {
  id            String    @id @default(cuid())
  code          String    @unique
  hostId        String
  animeId       String
  episodeId     String
  animeName     String
  episodeName   String?
  poster        String?
  isPublic      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  endedAt       DateTime?
  hostLeftAt    DateTime?
  lastActiveAt  DateTime  @default(now())

  host    User         @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)
  members RoomMember[]
  invites RoomInvite[]

  @@index([isPublic, lastActiveAt])
}

model RoomMember {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  role     String   @default("guest") // host | guest
  banned   Boolean  @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model RoomInvite {
  id         String   @id @default(cuid())
  roomId     String
  inviterId  String
  inviteeId  String
  status     String   @default("pending") // pending | accepted | declined | expired
  createdAt  DateTime @default(now())

  room    Room @relation(fields: [roomId],    references: [id], onDelete: Cascade)
  inviter User @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitesRecv", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([roomId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // watched_episode | favorited | list_added | created_list | hosted_room
  refId     String?
  meta      String?  // JSON blob
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // follow | follow_request | follow_accepted | invite | room_join
  payload   String    // JSON blob
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Favorite {
  id      String @id @default(cuid())
  userId  String
  animeId String
  name    String
  poster  String?
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model HistoryItem {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  animeName     String
  poster        String?
  episodeId     String
  episodeName   String
  episodeNumber Int?
  seasonNumber  Int?
  progress      Float    @default(0)
  duration      Float    @default(0)
  updatedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model UserList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]
}

model ListItem {
  id      String   @id @default(cuid())
  listId  String
  animeId String
  name    String
  poster  String?
  addedAt DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, animeId])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

model Preference {
  userId          String  @id
  theme           String  @default("dark")
  captionSettings String? // JSON blob
  autoPlay        Boolean @default(true)
  autoSkipIntro   Boolean @default(false)
  defaultQuality  String  @default("auto")
  defaultDubLanguage String @default("ja")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id             String @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  username       String
  credentials    String
  expiresAt      DateTime
  status         String @default("connected")
  error          String?
  lastSyncedAt   DateTime?
  nextRunAt      DateTime @default(now())
  leaseUntil     DateTime?
  leaseToken     String?
  attempts       Int @default(0)
  generation     Int @default(0)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots      SyncSnapshot[]
  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([nextRunAt, leaseUntil])
}

model OAuthTransaction {
  id          String @id @default(cuid())
  provider    String
  intent      String
  platform    String
  challenge   String
  stateHash   String @unique
  browserHash String?
  verifier    String?
  userId      String?
  status      String @default("pending")
  error       String?
  expiresAt   DateTime
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model TrackingEntry {
  id            String @id @default(cuid())
  userId        String
  sourceId      String?
  malId         Int?
  anilistId     Int?
  title         String
  totalEpisodes Int?
  mapping       String @default("unmapped")
  value         String
  version       Int @default(1)
  deleted       Boolean @default(false)
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots     SyncSnapshot[]
  @@unique([userId, sourceId])
  @@unique([userId, malId])
  @@unique([userId, anilistId])
}

model SyncSnapshot {
  integrationId String
  entryId       String
  base          String?
  remote        String?
  conflict      String?
  version       Int @default(0)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  entry         TrackingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@id([integrationId, entryId])
}

model EpisodeIntroSong {
  id         String   @id @default(cuid())
  animeId    String
  episodeId  String   @unique
  title      String?
  artist     String?
  coverUrl   String?
  spotifyUrl String?
  found      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([animeId])
}

model AppRelease {
  id            String   @id @default(cuid())
  version       String
  versionCode   Int      @default(1)
  notes         String?
  fileName      String
  filePath      String
  fileSize      Int
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

