generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  bio           String?
  role          String   @default("user") // user | admin
  profilePublic Boolean  @default(true)
  listsPublic   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favorites   Favorite[]
  history     HistoryItem[]
  lists       UserList[]
  listLikes   ListLike[]
  preference  Preference?
}

model Favorite {
  id      String @id @default(cuid())
  userId  String
  animeId String
  name    String
  poster  String?
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model HistoryItem {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  animeName     String
  poster        String?
  episodeId     String
  episodeName   String
  episodeNumber Int?
  seasonNumber  Int?
  progress      Float    @default(0)
  duration      Float    @default(0)
  updatedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model UserList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]
}

model ListItem {
  id      String   @id @default(cuid())
  listId  String
  animeId String
  name    String
  poster  String?
  addedAt DateTime @default(now())

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, animeId])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

model Preference {
  userId          String  @id
  theme           String  @default("dark")
  captionSettings String? // JSON blob
  autoPlay        Boolean @default(true)
  defaultQuality  String  @default("auto")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
